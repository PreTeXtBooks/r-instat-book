<?xml version="1.0" encoding="UTF-8"?>

<chapter xml:id="ch-intro" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Introduction</title>

  <introduction>
    <p>
      This book is a PreTeXt version.
      This is the skeleton to be filled in.
      Below are examples with:
      <ul>
        <li>a figure</li>
        <li>a table</li>
        <li>R code</li>
        <li>R output</li>
        <li>math formulae</li>
        <li>and a STACK question</li>
      </ul>
    </p>
  </introduction>

  <section xml:id="sec-adding-img-tbl">
    <title>New Section: Adding a Image and Table</title>

    <introduction>
      <p>
        Here we look at adding an image and a table
      </p>
    </introduction>

    <subsection xml:id="subsec-img-tbl">
      <title>Table and Image</title>

      <p>
        <xref ref="fig-placeholder"/> gives an example image, and
        <xref ref="table-placeholder"/> shows an example table.
      </p>
      <!-- Example Image -->
      <figure xml:id="fig-placeholder">
        <caption>Sample Caption</caption>
        <image source="images/placeholder.jpeg" width="50%">
          <description>
            <p>
              Sample description (in case image does not render)
            </p>
          </description>
        </image>
      </figure>
      <!-- Example Table -->
      <table xml:id="table-placeholder">
        <title>Sample Table</title>

        <tabular halign="left">
          <row header="yes">
            <cell>Column 1</cell>
            <cell>Column 2</cell>
            <cell>Column 3</cell>
          </row>

          <row>
            <cell>Value 1</cell>
            <cell>Value 2</cell>
            <cell>Value 3</cell>
          </row>
        </tabular>
      </table>
    </subsection>
  </section>
  <!-- Example R Code -->
  <section xml:id="sec-r-code-output">
    <title>R Code and Output</title>

    <p>
      Here is example R code and output.
    </p>

    <program language="r">
      <code>
      # Sample R code
      x &lt;- c(1, 2, 3, 4, 5)
      mean(x)
      </code>
    </program>
    <pre>
    ## [1] 3
    </pre>
  </section>

  <section xml:id="sec-maths-time">
    <title>maths-time</title>

    <p>
      Here we can write a formula in text
      <md>
        1 + 1 = 2
      </md>.
      Or as a new row:
      <md>
        <mrow>
        2 + 2 = 4
      </mrow>
      </md>
    </p>
    <!-- Example STACK Question -->
    <p>
      The following illustrates embedding a STACK question.
    </p>

    <exercise>
      <title>STACK integration question</title>

      <introduction>
        <p>
          A test question.
          (2025-08-15: you may need to ask for a <q>new</q> question to make
          this render.)
        </p>
      </introduction>
      <!-- A @label is required, becomes a filename in output -->
      <stack label="stack-integration" source="stack/01_integration_with_feedback.xml"/>
    </exercise>
  </section>
</chapter>
